-- Fluent UI + Meme Custom Background
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI
local Window = Fluent:CreateWindow({
    Title = "Hitbox Expander Hub | @bphong0946",
    SubTitle = "⚡ Meme Background Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false, -- Tắt acrylic để thấy rõ ảnh meme phía sau
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.H
})

-- Tạo Tabs
local Tabs = {
    Main = Window:AddTab({ Title = "Hitbox / ESP", Icon = "eye" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- ==========================================
-- TỰ ĐỘNG CHÈN ẢNH NỀN MEME TÙY CHỈNH
-- ==========================================
task.spawn(function()
    pcall(function()
        local CoreGui = game:GetService("CoreGui")
        local guiParent = CoreGui:FindFirstChild("Fluent") or LocalPlayer.PlayerGui:FindFirstChild("Fluent")
        
        if guiParent then
            -- Tìm Frame chính chứa các tab của Fluent
            local container = guiParent:FindFirstChild("Container") or guiParent:FindFirstChildWhichIsA("Frame", true)
            
            if container then
                local bgImage = Instance.new("ImageLabel")
                bgImage.Name = "MemeBackground"
                bgImage.Size = UDim2.new(1, 0, 1, 0)
                bgImage.Position = UDim2.new(0, 0, 0, 0)
                bgImage.BackgroundTransparency = 1
                
                -- Đổi ID bên dưới thành Decal ID của bức ảnh meme cậu muốn hiển thị
                -- (Nếu cậu tải ảnh lên Roblox sẽ nhận được mã rbxassetid://...)
                bgImage.Image = "rbxassetid://0" -- <-- THAY MÃ ID DECAL ẢNH MEME CỦA CẬU VÀO ĐÂY
                
                bgImage.ScaleType = Enum.ScaleType.Crop
                bgImage.ImageTransparency = 0.35 -- Chỉnh độ mờ của ảnh meme (0 = rõ nét, 1 = tàng hình)
                bgImage.ZIndex = -1
                bgImage.Parent = container
            end
        end
    end)
end)

-- ==========================================
-- BIẾN CẤU HÌNH HITBOX
-- ==========================================
local isHitboxActive = false
local hitboxSize = 4
local useHighlight = true

-- ==========================================
-- TAB CHÍNH: HITBOX & ESP
-- ==========================================
Tabs.Main:AddParagraph({
    Title = "Mở rộng Hitbox Đầu (Head Expander)",
    Content = "Phóng to phần đầu đối thủ và bật ESP Highlight trực tiếp để ngắm bắn chuẩn xác."
})

Tabs.Main:AddToggle("HitboxToggle", {
    Title = "Bật/Tắt Head Hitbox Expander",
    Default = false,
    Callback = function(Value)
        isHitboxActive = Value
        if not isHitboxActive then
            pcall(function()
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local head = player.Character:FindFirstChild("Head")
                        if head then
                            head.Size = Vector3.new(2, 1, 1)
                            local hl = head:FindFirstChild("HeadHighlight")
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end)
        end
    end
})

Tabs.Main:AddSlider("HitboxSizeSlider", {
    Title = "Kích thước Hitbox Đầu (Size)",
    Description = "Kéo để chỉnh độ to nhỏ của hitbox đầu",
    Default = 4,
    Min = 2,
    Max = 15,
    Rounding = 1,
    Callback = function(Value)
        hitboxSize = Value
    end
})

Tabs.Main:AddToggle("ESPHighlightToggle", {
    Title = "Bật/Tắt ESP Highlight Quanh Đầu",
    Default = true,
    Callback = function(Value)
        useHighlight = Value
        if not useHighlight then
            pcall(function()
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local head = player.Character:FindFirstChild("Head")
                        if head then
                            local hl = head:FindFirstChild("HeadHighlight")
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end)
        end
    end
})

-- ==========================================
-- LOGIC CHẠY NGẦM MỖI FRAME (RENDERSTEPPED)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isHitboxActive then return end
    
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                if character then
                    local head = character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        head.Transparency = 0.5
                        head.CanCollide = false
                        
                        if useHighlight then
                            local highlight = head:FindFirstChild("HeadHighlight")
                            if not highlight then
                                highlight = Instance.new("Highlight")
                                highlight.Name = "HeadHighlight"
                                highlight.Adornee = head
                                highlight.Parent = head
                                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                highlight.FillTransparency = 0.4
                                highlight.OutlineTransparency = 0
                            end
                        else
                            local highlight = head:FindFirstChild("HeadHighlight")
                            if highlight then highlight:Destroy() end
                        end
                    end
                end
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "Meme Hub Loaded!",
    Content = "Nhấn phím H để ẩn/hiện menu nhé!",
    Duration = 4
})
