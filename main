-- Fluent UI - Head Hitbox Expander & ESP Hub
-- Created by @bphong0946

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Khởi tạo Window Fluent UI riêng cho Hitbox
local Window = Fluent:CreateWindow({
    Title = "Hitbox Expander Hub | @bphong0946",
    SubTitle = "⚡ Head Hitbox & ESP Edition",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 400),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.K 
})

-- Tạo Tabs
local Tabs = {
    Main = Window:AddTab({ Title = "Hitbox / ESP", Icon = "eye" }),
    Settings = Window:AddTab({ Title = "Settings", Icon = "settings" })
}

-- ==========================================
-- BIẾN CẤU HÌNH HITBOX
-- ==========================================
local isHitboxActive = false
local hitboxSize = 4 -- Mặc định kích thước 4x4x4
local useHighlight = true

-- ==========================================
-- GIAO DIỆN TAB CHÍNH
-- ==========================================
Tabs.Main:AddParagraph({
    Title = "Mở rộng Hitbox Đầu (Head Expander)",
    Content = "Phóng to phần đầu đối thủ và bật ESP Highlight trực tiếp để ngắm bắn chuẩn xác."
})

-- Toggle Bật/Tắt Hitbox Expander
Tabs.Main:AddToggle("HitboxToggle", {
    Title = "Bật/Tắt Head Hitbox Expander",
    Default = false,
    Callback = function(Value)
        isHitboxActive = Value
        if not isHitboxActive then
            -- Trả lại kích thước gốc khi tắt
            pcall(function()
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local head = player.Character:FindFirstChild("Head")
                        if head then
                            head.Size = Vector3.new(2, 1, 1) -- Kích thước mặc định của Head
                            local hl = head:FindFirstChild("HeadHighlight")
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end)
        end
    end
})

-- Slider tùy chỉnh độ to Hitbox trực tiếp trong game
Tabs.Main:AddSlider("HitboxSizeSlider", {
    Title = "Kích thước Hitbox Đầu (Size)",
    Description = "Kéo để chỉnh độ to nhỏ của hitbox đầu đối thủ",
    Default = 4,
    Min = 2,
    Max = 15,
    Rounding = 1,
    Callback = function(Value)
        hitboxSize = Value
    end
})

-- Toggle bật/tắt ESP Highlight màu đỏ quanh đầu
Tabs.Main:AddToggle("ESPHighlightToggle", {
    Title = "Bật/Tắt ESP Highlight Quanh Đầu",
    Default = true,
    Callback = function(Value)
        useHighlight = Value
        if not useHighlight then
            pcall(function()
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local head = player.Character:FindFirstChild("Head")
                        if head then
                            local hl = head:FindFirstChild("HeadHighlight")
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end)
        end
    end
})

-- ==========================================
-- LOGIC CHẠY NGẦM MỖI FRAME (RENDERSTEPPED)
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not isHitboxActive then return end
    
    pcall(function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                if character then
                    local head = character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        -- Áp dụng kích thước mới từ Slider
                        head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                        head.Transparency = 0.5
                        head.CanCollide = false
                        
                        -- Xử lý ESP Highlight
                        if useHighlight then
                            local highlight = head:FindFirstChild("HeadHighlight")
                            if not highlight then
                                highlight = Instance.new("Highlight")
                                highlight.Name = "HeadHighlight"
                                highlight.Adornee = head
                                highlight.Parent = head
                                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                highlight.FillTransparency = 0.4
                                highlight.OutlineTransparency = 0
                            end
                        else
                            local highlight = head:FindFirstChild("HeadHighlight")
                            if highlight then highlight:Destroy() end
                        end
                    end
                end
            end
        end
    end)
end)

Window:SelectTab(1)
Fluent:Notify({
    Title = "Hitbox Expander Hub",
    Content = "Đã khởi chạy giao diện tùy chỉnh Hitbox độc lập thành công!",
    Duration = 4
})
